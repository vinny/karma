{
  "env": {
    "browser": true,
    "jquery": true,
    "es6": true,
    "jest": true
  },
  "globals": {
    "phpbb": "readonly"
  },
  "extends": "eslint:recommended",
  "parserOptions": {
    "ecmaVersion": 2018
  },
  "rules": {
    "no-unused-vars": ["error", { "args": "none" }],
    "quotes": ["error", "single", { "avoidEscape": true }]
  }
}
